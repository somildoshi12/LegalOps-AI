{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API and AI Agent Server for LegalOps AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
